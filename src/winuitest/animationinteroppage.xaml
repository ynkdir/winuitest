<?xml version="1.0" encoding="utf-8"?>
<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Orientation="Vertical">
        <TextBlock>Animation interop</TextBlock>
        <TextBlock>Hover over the button to animate its scale.</TextBlock>
        <Button x:Name="Button1" Width="100" Height="50" Content="Item"
            PointerEntered="Button1_PointerEntered" PointerExited="Button1_PointerExited" />
    </StackPanel>

</Page>
