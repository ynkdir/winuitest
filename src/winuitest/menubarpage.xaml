<?xml version="1.0" encoding="utf-8"?>
<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Orientation="Vertical">
        <TextBlock>MenuBar</TextBlock>
        <MenuBar>
            <MenuBarItem Title="File">
                <MenuFlyoutItem Text="New" Click="Menu_Click" />
                <MenuFlyoutItem Text="Open..." Click="Menu_Click" />
                <MenuFlyoutItem Text="Save" Click="Menu_Click" />
                <MenuFlyoutItem Text="Exit" Click="Menu_Click" />
            </MenuBarItem>

            <MenuBarItem Title="Edit">
                <MenuFlyoutItem Text="Undo" Click="Menu_Click" />
                <MenuFlyoutItem Text="Cut" Click="Menu_Click" />
                <MenuFlyoutItem Text="Copy" Click="Menu_Click" />
                <MenuFlyoutItem Text="Paste" Click="Menu_Click" />
            </MenuBarItem>

            <MenuBarItem Title="Help">
                <MenuFlyoutItem Text="About" Click="Menu_Click" />
            </MenuBarItem>
        </MenuBar>
        <TextBlock x:Name="Output" />
    </StackPanel>

</Page>
